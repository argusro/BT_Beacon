.pio/
.vscode/
*.bak

# Private keys must never be committed. The advertising key header is generated
# from keys/ on every build, so a fresh clone creates its own ring instead of
# inheriting someone else's identity.
keys/*.priv.hex
keys/*.priv
keys/*_devices.json
keys/*_keys.json
keys/*.pub.hex
src/beacon_keys.h

# fetched location reports (contains your location history)
reports.json
keys/*_history.json

# local virtualenvs
.venv/
__pycache__/

# deployment secrets
scripts/haystack/vps/.env

# local working notes (contains machine-specific paths and the deployment URL)
CONTEXT.md
